      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Parité sur un intervalle symétrique",
      "verso": "f paire : ∫₋ₐᵃf = 2∫₀ᵃf ; f impaire : ∫₋ₐᵃf = 0",
      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Inégalité de la moyenne",
      "verso": "m ≤ f ≤ M sur [a,b] ⇒ m(b−a) ≤ ∫ₐᵇf ≤ M(b−a)",
      "modeReponse": "auto_evaluation"
    }
