      "recto": "Intégration par parties",
      "verso": "∫ₐᵇ u'v = [uv]ₐᵇ − ∫ₐᵇ uv'",
      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Changement affine u = αx + β, avec α≠0",
