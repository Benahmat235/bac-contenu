      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Algorithme d'Euclide",
      "verso": "PGCD(a;b) = dernier reste non nul des divisions successives",
      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Lien PGCD–PPCM",
      "verso": "PGCD(a;b) × PPCM(a;b) = a × b",
      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Nombres premiers entre eux",
      "verso": "a et b premiers entre eux ⟺ PGCD(a;b) = 1",
      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Théorème de Bézout",
      "verso": "a et b premiers entre eux ⟺ il existe u, v tels que au + bv = 1",
