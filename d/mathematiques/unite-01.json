    {
      "type": "formule",
      "recto": "Théorème des gendarmes",
      "verso": "si g ≤ f ≤ h et lim g = lim h = l, alors lim f = l",
      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Asymptote horizontale",
      "verso": "si lim f = l (réel) en ±∞, alors y = l",
      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Asymptote verticale",
      "verso": "si lim f = ±∞ en x₀, alors x = x₀",
      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Asymptote oblique",
      "verso": "y = ax + b si lim [f(x) − (ax+b)] = 0",
      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Limite trigonométrique de référence",
      "verso": "lim(x→0) sin(x)/x = 1",
      "modeReponse": "auto_evaluation"
    },
    {
      "type": "formule",
      "recto": "Continuité",
      "verso": "f est continue en a si lim(x→a) f(x) = f(a)",
      "modeReponse": "auto_evaluation"
    }
